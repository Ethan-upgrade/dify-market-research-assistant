# ============================================================
# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不会进仓库。
# standalone/ 会自动读取同名环境变量（也可直接用 export / $env:）。
# ============================================================

# ---------- 模型（任何 OpenAI 兼容接口）----------
# DeepSeek 官方
MRA_BASE_URL=https://api.deepseek.com/v1
MRA_API_KEY=sk-REPLACE_ME
MRA_MODEL=deepseek-chat

# 备选：OpenAI            MRA_BASE_URL=https://api.openai.com/v1   MRA_MODEL=gpt-4o-mini
# 备选：通义千问           MRA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  MRA_MODEL=qwen-plus
# 备选：智谱 GLM           MRA_BASE_URL=https://open.bigmodel.cn/api/paas/v4  MRA_MODEL=glm-4-plus
# 备选：本地 Ollama        MRA_BASE_URL=http://127.0.0.1:11434/v1  MRA_API_KEY=ollama  MRA_MODEL=qwen2.5:14b
# 备选：vLLM / LM Studio   MRA_BASE_URL=http://127.0.0.1:8000/v1   MRA_API_KEY=local

MRA_TEMPERATURE=0.7
MRA_MAX_TOKENS=16384
MRA_TIMEOUT=180

# ---------- 联网检索 ----------
# https://app.tavily.com 注册即得，格式 tvly-xxxxxxxx
TAVILY_API_KEY=
MRA_SEARCH_DEPTH=advanced
MRA_MAX_RESULTS=6

# ---------- Dify（仅当你要用 dsl/ 里的工作流时才需要）----------
# DIFY_BASE_URL=http://127.0.0.1:8080
# DIFY_EMAIL=you@example.com
# DIFY_PASSWORD=change-me
# DIFY_MODEL=deepseek-chat
# DIFY_TAVILY_KEY=tvly-xxxxxxxx
